// ruleguard rules for enforcing clean architecture across packages (no src/)

package gorules

import "github.com/quasilyte/go-ruleguard/dsl"

// Ban os.Exit outside main packages (libraries should return errors instead)
func osExitInLib(m dsl.Matcher) {
	m.Match(`os.Exit($_)`).
		Where(!m.File().PkgPath.Matches(".*/cmd/.*") && !m.File().PkgPath.Matches(".*/e2e-tests/.*") && !m.File().Name.Matches("_test\\.go$") && !m.File().Name.Matches("-d$")).
		Report("use error returns; os.Exit only allowed in CLI (cmd) or tests")
}

// Disallow direct environment access in libraries (inject config)
func osGetenvInLib(m dsl.Matcher) {
	m.Match(`os.Getenv($_)`).
		Where(!m.File().PkgPath.Matches(".*/cmd/.*") && !m.File().PkgPath.Matches(".*/e2e-tests/.*") && !m.File().Name.Matches("_test\\.go$")).
		Report("do not use os.Getenv in libraries; allowed in CLI (cmd) and tests")
}
