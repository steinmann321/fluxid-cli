// Detect net.Dial without timeout
func testDialWithoutTimeout(m dsl.Matcher) {
	m.Match(`net.Dial($*_)`).
		Where(m.File().Name.Matches("_test\\.go$")).
		Report("use net.DialTimeout() instead of net.Dial() in tests to prevent hangs")
}

// Detect exec.Command without timeout/context
func testCommandWithoutContext(m dsl.Matcher) {
	m.Match(`exec.Command($*_)`).
		Where(m.File().Name.Matches("_test\\.go$")).
		Report("use exec.CommandContext() with timeout instead of exec.Command() to prevent test hangs")
}

// NON-DETERMINISM

// Detect rand usage without seed
func testRandWithoutSeed(m dsl.Matcher) {
	m.Match(`rand.Int($*_)`,
		`rand.Intn($*_)`,
		`rand.Float64($*_)`).
		Where(m.File().Name.Matches("_test\\.go$")).
		Report("rand usage without explicit seed; use rand.New(rand.NewSource(seed)) for deterministic tests")
}

// WAITGROUP PATTERNS

// This is harder to detect perfectly, but we can catch obvious cases
func testWaitGroupAddWithoutDone(m dsl.Matcher) {
	m.Match(`
		$wg.Add($_)
		go func() {
			$*body
		}()`).
		Where(m.File().Name.Matches("_test\\.go$") &&
		      !m["body"].Text.Matches(".*defer.*Done\\(\\).*") &&
		      !m["body"].Text.Matches(".*\\.Done\\(\\).*")).
		Report("WaitGroup.Add without corresponding Done in goroutine; add 'defer wg.Done()' or wg.Done() at end")
}

// TEST CLEANUP

// Detect t.Parallel() tests that modify shared state
func testParallelWithGlobalState(m dsl.Matcher) {
	m.Match(`
		func $name(t *testing.T) {
			t.Parallel()
			$*body
		}`).
		Where(m.File().Name.Matches("_test\\.go$") &&
		      (m["body"].Text.Matches(".*os\\.Setenv.*") ||
		       m["body"].Text.Matches(".*os\\.Chdir.*"))).
		Report("t.Parallel() test modifies global state (env/dir); this causes race conditions between parallel tests")
}

// PROJECT-AGNOSTIC PRODUCTION CODE RELIABILITY RULES
// These rules detect common patterns in production code that cause goroutine leaks,
// hangs, and unbounded resource consumption

// Detect goroutines started in production code without cancellation mechanism
// This is the root cause of goroutine leaks in production code
func goroutineWithoutCancellation(m dsl.Matcher) {
	m.Match(`go func() { $*body }()`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m.File().Name.Matches("test_helpers.*\\.go$") &&
		      !m.File().PkgPath.Matches(".*/internal/command") &&
		      !m["body"].Text.Matches(".*(ctx\\.Done|context\\.Done|<-done|<-stop|<-quit|<-ch).*") &&
		      !m["body"].Text.Matches(".*<-.*")).
		Report("goroutine started without cancellation mechanism; add context.Context or done channel to prevent leaks")

	m.Match(`go $fn($*args)`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m.File().Name.Matches("test_helpers.*\\.go$") &&
		      !m.File().PkgPath.Matches(".*/internal/command") &&
		      !m["fn"].Text.Matches("^func\\(.*")).
		Report("goroutine started; ensure function $fn handles context cancellation")
}

// Detect infinite for loops without exit conditions
// These can cause hangs if not properly bounded
func infiniteLoopWithoutExit(m dsl.Matcher) {
	m.Match(`
		for {
			$*body
		}`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m["body"].Text.Matches(".*(return|break|ctx\\.Done|context\\.Done|<-done|<-stop|os\\.Exit).*")).
		Report("infinite for loop without exit condition; add context check, break, or return to prevent hangs")
}

// Detect for-range channel loops without cancellation
// These will block forever if the channel is never closed
func forRangeChannelWithoutCancel(m dsl.Matcher) {
	m.Match(`
		for $_ := range $ch {
			$*body
		}`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m.File().PkgPath.Matches(".*/internal/command") &&
		      !m["body"].Text.Matches(".*(ctx\\.Done|context\\.Done|<-done|select).*")).
		Report("for-range channel loop without cancellation; add select with context.Done to prevent blocking")
}

// Detect retry loops without max attempts or timeout
// These can cause infinite retries and hangs
func unboundedRetryLoop(m dsl.Matcher) {
	m.Match(`
		for {
			$*before
			if $cond {
				$*retry
				continue
			}
			$*after
		}`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m["before"].Text.Matches(".*(maxRetries|maxAttempts|attempts|retries|timeout|deadline|ctx\\.Done).*") &&
		      !m["after"].Text.Matches(".*(maxRetries|maxAttempts|attempts|retries|timeout|deadline|ctx\\.Done).*")).
		Report("unbounded retry loop; add max attempts counter or context timeout to prevent infinite retries")
}

// Detect signal.Notify without signal.Stop
// This causes goroutine leaks as signal notification channels are never cleaned up
func signalNotifyWithoutStop(m dsl.Matcher) {
	m.Match(`
		func $name($*_) {
			$*_
			signal.Notify($ch, $*sigs)
			$*body
		}`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m["body"].Text.Matches(".*signal\\.Stop.*")).
		Report("signal.Notify without signal.Stop; add 'defer signal.Stop(ch)' to prevent goroutine leak")
}

// Detect time.NewTicker without Stop
// Tickers must be stopped to prevent goroutine leaks
func tickerWithoutStop(m dsl.Matcher) {
	m.Match(`
		$ticker := time.NewTicker($duration)
		$*body`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m["body"].Text.Matches(".*defer.*\\.Stop\\(\\).*") &&
		      !m["body"].Text.Matches(".*\\.Stop\\(\\).*")).
		Report("time.NewTicker without Stop; add 'defer ticker.Stop()' to prevent goroutine leak")
}

// Detect context.Background() in library functions
// Library code should accept context from callers, not create root contexts
func contextBackgroundInFunction(m dsl.Matcher) {
	m.Match(`context.Background()`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m.File().Name.Matches("test_helpers.*\\.go$") &&
		      !m.File().PkgPath.Matches(".*/cmd/.*") &&
		      !m.File().PkgPath.Matches(".*/internal/command") &&
		      !m.File().PkgPath.Matches(".*/internal/workflow")).
		Report("avoid context.Background() in library code; accept context.Context as parameter to support cancellation")
}

// Detect long-running operations without context parameter
// Functions with loops, retries, or blocking operations should accept context for cancellation
func longRunningFunctionWithoutContext(m dsl.Matcher) {
	m.Match(`
		func $name($*params) $*returns {
			$*before
			for $*loop {
				$*body
			}
			$*after
		}`).
		Where(!m.File().Name.Matches("_test\\.go$") &&
		      !m.File().PkgPath.Matches(".*/cmd/.*") &&
		      !m.File().Name.Matches("^main\\.go$") &&
		      !m["params"].Text.Matches(".*context\\.Context.*") &&
		      (m["body"].Text.Matches(".*(time\\.Sleep|http\\.|net\\.|io\\.|exec\\.).*") ||
		       m["loop"].Text.Matches(".*range.*"))).
		Report("long-running function without context.Context parameter; add ctx context.Context to support cancellation")
}
