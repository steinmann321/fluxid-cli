#!/usr/bin/env bash
# fluxid - Development workflow automation CLI
# Main entry point for fluxid automated implement-commit-review loops

set -euo pipefail

# Resolve project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Generate UUID v4 session ID
generate_session_id() {
  if command -v uuidgen &>/dev/null; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  else
    # Fallback: generate pseudo-UUID using bash
    printf '%08x-%04x-4%03x-%04x-%012x' \
      $((RANDOM * RANDOM)) \
      $((RANDOM)) \
      $((RANDOM % 4096)) \
      $((RANDOM % 16384 + 32768)) \
      $((RANDOM * RANDOM * RANDOM))
  fi
}

# Display initialization status
show_initialization() {
  local agent="$1"
  local session_id="$2"
  local max_review_cycles="$3"
  local max_implement_retries="$4"

  echo ""
  echo "════════════════════════════════════════════════════════════"
  echo -e "${CYAN}FLUXID WORKFLOW AUTOMATION${NC}"
  echo "════════════════════════════════════════════════════════════"
  echo -e "  ${BLUE}Agent:${NC}            $agent"
  echo -e "  ${BLUE}Session ID:${NC}       $session_id"
  echo -e "  ${BLUE}Review Cycles:${NC}    $max_review_cycles (max)"
  echo -e "  ${BLUE}Implement Retries:${NC} $max_implement_retries (max per cycle)"
  echo "════════════════════════════════════════════════════════════"
  echo ""
}

# Show usage
show_usage() {
  cat << ENDHELP
fluxid - Development Workflow Automation

Usage:
  fluxid --claude [epic-id]
  fluxid --codex [epic-id]
  fluxid --opencode [epic-id]
  fluxid --help

Options:
  --claude     Use Claude agent for automation (default)
  --codex      Use Codex agent for automation
  --opencode   Use OpenCode agent for automation
  --headed     Run E2E tests in headed mode (visible browser)
  --dry-run    Run in dry-run mode (for testing, simulates workflow)
  --help, -h   Show this help message

Arguments:
  epic-id      Epic ID to process (e.g., m01-e01-user-runs-workflow.md)

Description:
  Runs automated implement→commit→review loops for the specified epic.
  - Generates unique session ID for tracking
  - Executes up to 20 review cycles
  - Retries implementation up to 3 times per cycle
  - Streams real-time output from agent
  - Propagates FLUXID_SESSION_ID to child processes

Examples:
  # Run workflow with Claude for specific epic
  fluxid --claude m01-e01-user-runs-workflow-to-completion.md

  # Run with headed browser for debugging
  fluxid --claude --headed m01-e01-user-runs-workflow-to-completion.md

ENDHELP
}

# Main function
main() {
  local agent="claude"
  local epic_id=""
  local extra_args=()

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case $1 in
      --claude)
        agent="claude"
        shift
        ;;
      --codex)
        agent="codex"
        shift
        ;;
      --opencode)
        agent="opencode"
        shift
        ;;
      --headed)
        extra_args+=("$1")
        shift
        ;;
      --dry-run)
        extra_args+=("$1")
        shift
        ;;
      --help|-h)
        show_usage
        exit 0
        ;;
      -*)
        echo -e "${RED}Error: Unknown option: $1${NC}" >&2
        echo "" >&2
        show_usage
        exit 1
        ;;
      *)
        epic_id="$1"
        shift
        ;;
    esac
  done

  # Validate epic-id provided
  if [[ -z "$epic_id" ]]; then
    echo -e "${RED}Error: Epic ID is required${NC}" >&2
    echo "" >&2
    show_usage
    exit 1
  fi

  # Check if epic-loop.sh exists
  local epic_loop_script="$PROJECT_ROOT/.fluxid/scripts/loop/epic-loop.sh"
  if [[ ! -f "$epic_loop_script" ]]; then
    echo -e "${RED}Error: epic-loop.sh not found at $epic_loop_script${NC}" >&2
    exit 1
  fi

  # Generate session ID and export
  local session_id
  session_id="$(generate_session_id)"
  export FLUXID_SESSION_ID="$session_id"

  # Configuration
  local max_review_cycles=20
  local max_implement_retries=3

  # Display initialization
  show_initialization "$agent" "$session_id" "$max_review_cycles" "$max_implement_retries"

  # Execute epic-loop.sh with appropriate agent flag
  echo -e "${BLUE}▶ Starting workflow loop...${NC}"
  echo ""

  # Build command with extra args if present
  if [[ ${#extra_args[@]} -gt 0 ]]; then
    "$epic_loop_script" "--${agent}" "${extra_args[@]}" "$epic_id"
  else
    "$epic_loop_script" "--${agent}" "$epic_id"
  fi
  
  local exit_code=$?
  
  if [[ $exit_code -eq 0 ]]; then
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo -e "${GREEN}✅ WORKFLOW COMPLETED SUCCESSFULLY${NC}"
    echo "════════════════════════════════════════════════════════════"
    echo -e "  Session ID: $session_id"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    exit 0
  else
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo -e "${RED}❌ WORKFLOW FAILED${NC}"
    echo "════════════════════════════════════════════════════════════"
    echo -e "  Session ID: $session_id"
    echo -e "  Exit Code:  $exit_code"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    exit "$exit_code"
  fi
}

main "$@"
